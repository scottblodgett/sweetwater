# The window's server environment. Neither value is ever sent to a browser: app/api/ops/* proxies every call.
# Where `python main.py --api` is listening. Default matches API_HOST / API_PORT in the repo's .env.example.
OPS_API_URL=http://127.0.0.1:8000
# ONE secret from the API's OPS_API_TOKEN (the part after `name:`), not the name:secret pair. The API maps it back to the name, and that name is `decided_by` on every gate receipt this window produces.
OPS_API_TOKEN=
