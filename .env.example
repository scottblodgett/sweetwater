# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Upstream ranch (already deployed; this repo does not own them) ----------
# The MCP server's Lambda Function URL. 19 tools + the ranch://sensors/map resource.
MCP_URL=https://uffvjih2m7e5szmi6zkrcwk22u0zwhvz.lambda-url.us-west-1.on.aws/

# The four REST APIs. sensors.py sweeps the Sensor API directly (not via MCP)
# because 160 reads per tick through a tool wrapper is pure overhead.
FARM_API=https://dqh8hahq8a.execute-api.us-west-1.amazonaws.com
FEED_API=https://49gl07qf6l.execute-api.us-west-1.amazonaws.com
SENSOR_API=https://9daxznkz7e.execute-api.us-west-1.amazonaws.com
CARE_API=https://t5v8evdtg2.execute-api.us-west-1.amazonaws.com

# Per-request upstream deadline. A deadline protects the waiter, never the callee.
UPSTREAM_TIMEOUT_MS=15000
# Bounded fan-out for the per-tick sweep. Unbounded at 160 reads as a load test.
SWEEP_CONCURRENCY=20

# --- Agent state (sw_ops schema; NEVER the ranch schemas) --------------------
# Supabase session-mode pooler. asyncpg needs statement_cache_size=0 behind pgBouncer;
# the engine factory sets that, do not put it in the URL.
DATABASE_URL=postgresql+asyncpg://user:pass@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# Tests only. A local database, never Supabase.
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/sweetwater_test

# --- Models ------------------------------------------------------------------
ANTHROPIC_API_KEY=
TIER2_MODEL=claude-opus-5
OLLAMA_BASE_URL=http://localhost:11434
TIER1_MODEL=gemma4:e4b
# Explicit on purpose. The OpenAI-compatible shim silently ignores this; ChatOllama honors it.
OLLAMA_NUM_CTX=16384

# --- Tick loop ---------------------------------------------------------------
TICK_INTERVAL_SECONDS=300

# --- Chaos -------------------------------------------------------------------
CHAOS_ENABLED=1
# Same seed replays the same demo. Chaos that cannot be reproduced is a flake.
CHAOS_SEED=1
# Real PATCH/POST against the live Farm and Care APIs. Off by default.
CHAOS_ALLOW_WRITES=0
# Only these animals may ever be mutated, so the rest of the herd stays pristine.
CHAOS_ANIMAL_COHORT=cow-0901,cow-0902,cow-0903,cow-0904,cow-0905

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
# 1 = human-readable console. 0 = JSON on stdout too (for a container).
LOG_CONSOLE_PRETTY=1
# 1 = write full prompt/response bodies to logs/transcripts/. Off by default: prompts are the token bill.
LOG_TRANSCRIPTS=0
